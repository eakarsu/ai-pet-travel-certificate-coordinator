 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([petJourneyId])
 linkedTravelPetId TravelPet @relation("PetLabResult_travelPetId", fields: [travelPetId], references: [id], onDelete: Restrict)
 linkedPetJourneyId PetJourney @relation("PetLabResult_petJourneyId", fields: [petJourneyId], references: [id], onDelete: Restrict)
}

model DestinationRule {
 id String @id @default(cuid())
 title String
 jurisdiction String
 version String
 effectiveAt DateTime
 requirementText String
 sourceUrl String
 status String @default("Draft")
 petJourneyId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([petJourneyId])
 linkedPetJourneyId PetJourney @relation("DestinationRule_petJourneyId", fields: [petJourneyId], references: [id], onDelete: Restrict)
}

model HealthCertificate {
 id String @id @default(cuid())
 title String
 travelPetId String
 issuedAt DateTime
 validUntil DateTime
 veterinarian String
 endorsementReceipt String?
 status String @default("Draft")
 petJourneyId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([petJourneyId])
