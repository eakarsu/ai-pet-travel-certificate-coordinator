 vaccine String
 administeredAt DateTime
 expiresAt DateTime
 lotNumber String
 status String @default("Draft")
 petJourneyId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([petJourneyId])
 linkedTravelPetId TravelPet @relation("PetVaccination_travelPetId", fields: [travelPetId], references: [id], onDelete: Restrict)
 linkedPetJourneyId PetJourney @relation("PetVaccination_petJourneyId", fields: [petJourneyId], references: [id], onDelete: Restrict)
}

model PetLabResult {
 id String @id @default(cuid())
 title String
