model BorderHandoff {
 id String @id @default(cuid())
 title String
 travelPetId String
 handedAt DateTime
 receivingAgent String
 documents String
 receipt String?
 status String @default("Draft")
 petJourneyId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([petJourneyId])
 linkedTravelPetId TravelPet @relation("BorderHandoff_travelPetId", fields: [travelPetId], references: [id], onDelete: Restrict)
 linkedPetJourneyId PetJourney @relation("BorderHandoff_petJourneyId", fields: [petJourneyId], references: [id], onDelete: Restrict)
}

model OperationalTask {
 id String @id @default(cuid())
 title String
 owner String
 priority String
 startAt DateTime
 dueAt DateTime
 done Boolean
 notes String?
 status String @default("Draft")
 petJourneyId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([petJourneyId])
 linkedPetJourneyId PetJourney @relation("OperationalTask_petJourneyId", fields: [petJourneyId], references: [id], onDelete: Restrict)
}

model RuleVersion {
 id String @id @default(cuid())
 title String
 jurisdiction String
 version String
 effectiveAt DateTime
 expiresAt DateTime?
 sourceUrl String
 requirementText String
 status String @default("Draft")
 petJourneyId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([petJourneyId])
 linkedPetJourneyId PetJourney @relation("RuleVersion_petJourneyId", fields: [petJourneyId], references: [id], onDelete: Restrict)
}

model DocumentRequirement {
 id String @id @default(cuid())
 title String
